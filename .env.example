# Copy to .env for local use. Never put real credentials in this file or commit .env.
RUN_ENV=local
TEST_ENVIRONMENT=qa
PLATFORM=android
APPIUM_URL=http://127.0.0.1:4723

# Local Android device/app settings; the runner discovers the activity if blank.
DEVICE_NAME=emulator-5554
UDID=
PLATFORM_VERSION=
APP_PACKAGE=com.androidsample.generalstore
APP_ACTIVITY=
APP_WAIT_ACTIVITY=
CHROMEDRIVER_EXECUTABLE=
NEW_COMMAND_TIMEOUT=
UIAUTOMATOR2_SERVER_LAUNCH_TIMEOUT=
APP_WAIT_DURATION=
AUTO_GRANT_PERMISSIONS=true
# Reset only this test app's data before each run for repeatable scenarios.
RESET_APP_DATA=true
NO_RESET=true

# iOS local sessions require IOS_DEVICE_NAME plus either IOS_BUNDLE_ID or IOS_APP.
IOS_DEVICE_NAME=
IOS_UDID=
IOS_PLATFORM_VERSION=
IOS_BUNDLE_ID=
IOS_APP=

# Required only for BrowserStack runs.
QA_BROWSERSTACK_USERNAME=
QA_BROWSERSTACK_ACCESS_KEY=
STAGE_BROWSERSTACK_USERNAME=
STAGE_BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ANDROID=
BROWSERSTACK_APP_IOS=
# The selected profile resolves its credentials into BROWSERSTACK_USERNAME and
# BROWSERSTACK_ACCESS_KEY before the BrowserStack session is created.
# Optional: select device names and OS versions enabled for your BrowserStack plan.
BROWSERSTACK_ANDROID_DEVICE_NAME=
BROWSERSTACK_ANDROID_OS_VERSION=
BROWSERSTACK_IOS_DEVICE_NAME=
BROWSERSTACK_IOS_OS_VERSION=
BROWSERSTACK_DEVICE_NAME=
BROWSERSTACK_OS_VERSION=
BROWSERSTACK_APP=

# Optional reporting/recording flags.
FAILURE_SCREENSHOTS=true
DUMP_DOM_ON_FAILURE=true
# Failure DOM is saved locally in the system temp directory by default.
DOM_DUMP_DIR=
TAKE_ALL_SCREENS=false
RECORD_VIDEO=false
ACTION_SCREENSHOTS=false
